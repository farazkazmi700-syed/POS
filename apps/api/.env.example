PORT=3000
MONGO_URI=mongodb://localhost:27017/pos
REDIS_URL=redis://localhost:6379
# REQUIRED: Replace with strong random secrets in production. Never commit real values.
JWT_ACCESS_SECRET=REPLACE_ME_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_WITH_STRONG_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# REQUIRED: Comma-separated frontend origins allowed to call the API (e.g. http://localhost:5173,http://localhost:8080).
CORS_ORIGIN=REPLACE_ME_WITH_CORS_ORIGINS
# REQUIRED: Base URL for password reset links (must match frontend origin, e.g. http://localhost:8080/reset-password).
PASSWORD_RESET_BASE_URL=REPLACE_ME_WITH_RESET_URL
# Developer account authorized to create businesses; store a bcrypt hash, never the plaintext password.
DEV_ACCOUNT_EMAIL=kazmitech142@gmail.com
DEV_ACCOUNT_PASSWORD_HASH=
# Existing active Owner account that manages business creation and subscription plans.
PLATFORM_DEVELOPER_EMAIL=
# A private random value of at least 32 characters. Never commit a real token.
PLATFORM_DEVELOPER_SETUP_TOKEN=REPLACE_ME_WITH_SETUP_TOKEN
# Gmail SMTP app-password settings used for email verification and PIN resets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Folder shared with the pdf-worker (generated invoices live here)
STORAGE_DIR=../../storage/record of business
# Timezone used for the daily sales report
REPORT_TZ=Asia/Karachi
