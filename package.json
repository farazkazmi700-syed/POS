{
  "name": "pos-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant POS with government-style PDF invoices (NestJS + React + PostgreSQL)",
  "scripts": {
    "install:all": "npm --prefix app/api install && npm --prefix app/web install && npm --prefix app/pdf-worker install",
    "infra": "docker compose -f docker/compose/compose.yaml up -d",
    "dev:api": "npm --prefix app/api run start:dev",
    "dev:worker": "npm --prefix app/pdf-worker run dev",
    "dev:web": "npm --prefix app/web run dev",
    "test:api": "npm --prefix app/api test",
    "build": "node deploy/scripts/build.cjs",
    "seed": "npx tsx deploy/scripts/seed.ts",
    "dev:all": "concurrently --names api,worker,web --prefix-colors cyan,yellow,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "build:web": "npm --prefix app/web run build",
    "docker:rebuild": "docker compose -f docker/compose/compose.yaml build --no-cache",
    "docker:start": "docker compose -f docker/compose/compose.yaml up -d",
    "docker:stop": "docker compose -f docker/compose/compose.yaml down",
    "docker:logs": "docker compose -f docker/compose/compose.yaml logs -f",
    "docker:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/scripts/prepare-compose-env.ps1",
    "docker:update": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/scripts/update-docker.ps1",
    "docker:update:nocache": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/scripts/update-docker.ps1 -NoCache",
    "test:pdf": "npm --prefix app/pdf-worker run test",
    "test:web:typecheck": "npm --prefix app/web run typecheck",
    "test:all": "npm run test:api && npm run test:pdf",
    "db:migrate": "node deploy/scripts/migrate/run-migrations.cjs",
    "db:backup:mongo": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/scripts/backup/mongo-backup.ps1",
    "db:backup:pg": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/scripts/backup/pg-backup.ps1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
