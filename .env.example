# ============================================================
# KazmiOn POS — Single Environment Configuration
# ============================================================
# This is the ONLY .env file for the entire monorepo.
# All apps (API, PDF Worker, Web) read from this file.
#
# Docker: npm run docker:start after the first image build.
# The single container serves the POS at http://localhost:8080.
# For frontend hot reload, run npm run dev:web with the container running.
# PostgreSQL passwords are generated at first boot and kept on the database volume.
# ============================================================

# ── Core ─────────────────────────────────────────────────────
PORT=3000
# Legacy standalone developer tools only. The container supplies its PostgreSQL gateway URI.
# MONGO_URI=mongodb://localhost:27017/pos
REDIS_URL=redis://localhost:6379

# ── Authentication ───────────────────────────────────────────
# REQUIRED: Replace with strong random secrets in production. Never commit real values.
JWT_ACCESS_SECRET=REPLACE_ME_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_WITH_STRONG_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS & Frontend ─────────────────────────────────────────
# REQUIRED: Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# REQUIRED: Base URL for password reset links (must match a frontend origin).
PASSWORD_RESET_BASE_URL=REPLACE_ME_WITH_RESET_URL

# ── Developer Console ───────────────────────────────────────
# Legacy developer account for the /auth/register endpoint.
DEV_ACCOUNT_EMAIL=kazmitech142@gmail.com
DEV_ACCOUNT_PASSWORD_HASH=
# Platform developer account provisioned through the setup-password flow.
PLATFORM_DEVELOPER_EMAIL=developer@pos.local
# A private random value of at least 32 characters. Never commit a real token.
PLATFORM_DEVELOPER_SETUP_TOKEN=REPLACE_ME_WITH_SETUP_TOKEN

# ── Email (SMTP) ────────────────────────────────────────────
# Gmail SMTP app-password settings used for email verification and PIN resets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── WhatsApp OTP (Twilio) ───────────────────────────────────
# Optional Twilio WhatsApp Business authentication template. Variable 1 is the OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# ── PDF Worker ───────────────────────────────────────────────
STORAGE_DIR=../../storage/record of business
REPORT_TZ=Asia/Karachi
WORKER_CONCURRENCY=2
# Only needed when Chromium is installed system-wide (Docker image sets this).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Invoice Storage ─────────────────────────────────────────
# PostgreSQL takes priority when an invoice database registry is configured.
# Set both API and worker to the same mode; see README.md#ref-31.
# INVOICE_STORE=postgres
# INVOICE_DATABASES_FILE=/absolute/path/to/protected/invoice-databases.json

# ── Backup ───────────────────────────────────────────────────
# Developer platform backup delivery. Offline defaults to ZIP download only.
BACKUP_MODE=offline
BACKUP_EMAIL_TO=
# Email uses existing SMTP_* settings (Gmail app password or other SMTP provider).
BACKUP_DRIVE_CLIENT_ID=
BACKUP_DRIVE_CLIENT_SECRET=
BACKUP_DRIVE_REFRESH_TOKEN=
BACKUP_DRIVE_FOLDER_ID=

# ── Web (Vite) ──────────────────────────────────────────────
# Only used by Vite dev server proxy. In Docker, nginx handles /api proxying.
VITE_API_URL=http://localhost:3000

# Existing installation only: select its provisioned volumes before first startup.
# KAZMION_EXISTING_VOLUMES=true
# KAZMION_PG_VOLUME=your_existing_pg_volume
# KAZMION_UPLOAD_VOLUME=your_existing_invoice_volume
# KAZMION_QUEUE_VOLUME=your_existing_redis_volume
