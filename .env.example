# ============================================================
# KazmiOn POS � Environment Configuration
# ============================================================
# DEV SETUP (choose one):
#   Option A � Vite dev server  (port 5173, hot reload):
#     npm run infra          <- starts MongoDB + Redis
#     npm run dev:all        <- starts API + PDF worker + Web
#     Open: http://localhost:5173
#
#   Option B � Docker stack   (port 8080, production build):
#     npm run docker:rebuild <- build images fresh
#     npm run docker:start   <- start full stack
#     Open: http://localhost:8080
#
#   Both options use the SAME source, same APIs, same database.
#   The only difference is the web server (Vite vs Nginx).
# ============================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Used by docker-compose.yml  (copy to .env and change the secrets!)
PORT=3000
MONGO_URI=mongodb://localhost:27017/pos
REDIS_URL=redis://localhost:6379
# REQUIRED: Replace with strong random secrets in production. Never commit real values.
JWT_ACCESS_SECRET=REPLACE_ME_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_WITH_STRONG_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# REQUIRED: Comma-separated frontend origins allowed to call the API (e.g. http://localhost:5173,http://localhost:8080).
# REQUIRED: Base URL for password reset links (must match frontend origin, e.g. http://localhost:8080/reset-password).
PASSWORD_RESET_BASE_URL=REPLACE_ME_WITH_RESET_URL
# Password hash for the developer allowed to create business accounts. Store a bcrypt hash, never plaintext.
DEV_ACCOUNT_EMAIL=kazmitech142@gmail.com
DEV_ACCOUNT_PASSWORD_HASH=52909063
# Platform account provisioned through the authorized developer setup flow.
PLATFORM_DEVELOPER_EMAIL=fzkamzi700@gmail.com
# A private random value of at least 32 characters. Never commit a real token.
PLATFORM_DEVELOPER_SETUP_TOKEN=REPLACE_ME_WITH_SETUP_TOKEN
# Gmail SMTP app-password settings used for email verification and PIN resets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Twilio WhatsApp Business authentication template. Variable 1 is the OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
STORAGE_DIR=../../storage/record of business
REPORT_TZ=Asia/Karachi
WORKER_CONCURRENCY=2
# PostgreSQL takes priority when an invoice database registry is configured.
# Set both API and worker to the same mode; see docs/migration/09-hybrid-invoices.md.
# INVOICE_STORE=postgres
# INVOICE_DATABASES_FILE=/absolute/path/to/protected/invoice-databases.json

# Developer platform backup delivery. Offline defaults to ZIP download only.
BACKUP_MODE=offline
BACKUP_EMAIL_TO=
# Email uses existing SMTP_* settings (Gmail app password or other SMTP provider).
BACKUP_DRIVE_CLIENT_ID=
BACKUP_DRIVE_CLIENT_SECRET=
BACKUP_DRIVE_REFRESH_TOKEN=
BACKUP_DRIVE_FOLDER_ID=
