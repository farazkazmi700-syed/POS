# Used by docker-compose.yml  (copy to .env and change the secrets!)
PORT=3000
MONGO_URI=mongodb://localhost:27017/pos
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Password hash for the developer allowed to create business accounts.
DEV_ACCOUNT_EMAIL=kazmitech142@gmail.com
DEV_ACCOUNT_PASSWORD_HASH=
# Platform account provisioned through the authorized developer setup flow.
PLATFORM_DEVELOPER_EMAIL=
# A private random value of at least 32 characters. Never commit a real token.
PLATFORM_DEVELOPER_SETUP_TOKEN=
# Gmail SMTP app-password settings used for email verification and PIN resets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Twilio WhatsApp Business authentication template. Variable 1 is the OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
STORAGE_DIR=../../storage/record of business
REPORT_TZ=Asia/Karachi
WORKER_CONCURRENCY=2
# PostgreSQL takes priority when an invoice database registry is configured.
# Set both API and worker to the same mode; see docs/migration/09-hybrid-invoices.md.
# INVOICE_STORE=postgres
# INVOICE_DATABASES_FILE=/absolute/path/to/protected/invoice-databases.json

# Developer platform backup delivery. Offline defaults to ZIP download only.
BACKUP_MODE=offline
BACKUP_EMAIL_TO=
# Email uses existing SMTP_* settings (Gmail app password or other SMTP provider).
BACKUP_DRIVE_CLIENT_ID=
BACKUP_DRIVE_CLIENT_SECRET=
BACKUP_DRIVE_REFRESH_TOKEN=
BACKUP_DRIVE_FOLDER_ID=
