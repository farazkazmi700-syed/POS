# Only used by `npm run dev` (proxy target for /api).
# In Docker/production, nginx proxies /api to the API container; Vite is not involved.
VITE_API_URL=http://localhost:3000

# Public API base used by the built bundle. Leave empty when the API is served
# from the same origin (Docker/nginx). For a split deployment such as Cloudflare
# Pages + a separately hosted API, set the full URL including /api, e.g.
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=
