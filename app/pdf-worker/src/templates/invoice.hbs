<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{invoiceNo}}</title>
<style>
  @font-face { font-family: 'InvSans'; src: url('data:font/ttf;base64,{{{fonts.latin}}}') format('truetype'); font-weight: 100 900; font-display: block; }
  @font-face { font-family: 'InvUrdu'; src: url('data:font/ttf;base64,{{{fonts.urdu}}}') format('truetype'); font-weight: 100 900; font-display: block; }
  @page { size: {{paper.width}}mm {{paper.height}}mm; margin: {{paper.margin}}mm; }

  :root {
    --navy: #334155;
    --navy-dark: #111827;
    --navy-soft: #f8fafc;
    --amber: #f59e0b;
    --amber-light: #fef3c7;
    --red: #dc2626;
    --red-light: #fee2e2;
    --green: #16a34a;
    --green-light: #dcfce7;
    --slate: #64748b;
    --slate-light: #f1f5f9;
    --line: #e2e8f0;
    --ink: #1e293b;
    --white: #ffffff;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'InvSans', 'InvUrdu', sans-serif; font-size: 11px; line-height: 1.5; font-variant-numeric: lining-nums tabular-nums; color: var(--ink); background: #fff; position: relative; }
  bdi { unicode-bidi: isolate; }
  .urdu, .invoice-urdu { direction: rtl; unicode-bidi: isolate; letter-spacing: 0; line-height: 1.65; }

  /* ── Watermarks ── */
  .text-watermark { position: fixed; top: 45%; left: 5%; width: 90%; text-align: center; transform: rotate(-25deg); opacity: .08; font-size: 28px; font-weight: 700; letter-spacing: 2px; overflow-wrap: anywhere; color: var(--ink); pointer-events: none; z-index: 0; }
  .logo-watermark { position: fixed; left: 50%; top: 50%; width: 420px; height: 420px; transform: translate(-50%, -50%) rotate(-18deg); opacity: 0.04; pointer-events: none; z-index: 0; }
  .logo-watermark img { width: 100%; height: 100%; object-fit: contain; filter: grayscale(100%); }

  .page { position: relative; z-index: 1; }

  /* ── Header ── */
  .header { display: table; width: 100%; border-collapse: collapse; padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--line); }
  .header-left { display: table-cell; width: 58%; vertical-align: top; padding-right: 16px; }
  .header-right { display: table-cell; vertical-align: top; padding-left: 10px; text-align: right; }
  .brand-logo { max-width: 130px; max-height: 48px; object-fit: contain; object-position: left center; display: block; margin-bottom: 6px; }
  .biz-name { color: var(--navy-dark); font-size: 18px; font-weight: 800; line-height: 1.2; margin-bottom: 4px; letter-spacing: -0.2px; }
  .biz-detail { color: var(--slate); font-size: 9.5px; margin-top: 2px; }
  .biz-ntn { color: var(--slate); font-size: 9.5px; margin-top: 2px; }
  .invoice-title { display: inline-block; color: var(--navy-dark); font-size: 19px; font-weight: 900; letter-spacing: -0.4px; line-height: 1.2; }
  .invoice-urdu { font-size: 11px; color: var(--slate); margin-top: 1px; }
  .payment-badge { display: inline-block; color: var(--slate); font-size: 9px; font-weight: 600; margin-top: 4px; }
  .meta-table { margin-top: 8px; border-collapse: collapse; width: 100%; }
  .meta-table td { padding: 2px 0 2px 8px; font-size: 9.5px; }
  .meta-table td:first-child { color: var(--slate); padding-left: 0; white-space: nowrap; }
  .meta-table td:last-child { text-align: right; font-weight: 600; }
  .meta-table tr:first-child td:last-child { color: var(--navy-dark); font-size: 11px; font-weight: 800; letter-spacing: .2px; }

  /* ── Customer card ── */
  .customer-card { display: table; width: 100%; border-collapse: collapse; margin: 8px 0 12px; }
  .customer-card-row { display: table-row; }
  .customer-col { display: table-cell; width: 50%; vertical-align: top; padding-right: 12px; }
  .customer-col + .customer-col { padding-right: 0; padding-left: 12px; border-left: 1px solid var(--line); }
  .card-eyebrow { color: var(--navy); font-size: 8px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 3px; }
  .card-name { color: var(--ink); font-size: 11.5px; font-weight: 700; margin-bottom: 2px; }
  .card-detail { color: var(--slate); font-size: 9px; margin-top: 1px; }

  /* ── Divider ── */
  .rule { border: 0; border-top: 1px solid var(--line); margin: 10px 0; }

  /* ── Items table ── */
  .items { width: 100%; border-collapse: collapse; margin-top: 4px; }
  .items th { color: var(--ink); text-align: left; padding: 7px; font-size: 9px; font-weight: 700; border-block: 1px solid var(--line); }
  .items tr { break-inside: avoid; }
  .items .col-desc { overflow-wrap: anywhere; }
  .compact-detail { display: none; }
  .items th.right, .items td.right { text-align: right; }
  .items td { padding: 7px; border-bottom: 1px solid var(--line); font-size: 9.5px; vertical-align: top; }
  .items tbody tr:last-child td { border-bottom: none; }
  .items td:last-child, .items td.amt { font-weight: 700; color: var(--ink); white-space: nowrap; }
  .product-sub { display: block; color: var(--slate); font-size: 8px; margin-top: 2px; }
  .items tfoot td { background: var(--navy-soft); font-weight: 700; }

  /* ── Totals ── */
  .totals-wrap { width: 56%; margin-left: auto; margin-top: 14px; }
  .totals { width: 100%; border-collapse: collapse; break-inside: avoid; }
  .totals td { padding: 5px 9px; font-size: 9.5px; border-bottom: 1px solid var(--line); background: #fff; }
  .totals tr:last-child td { border-bottom: none; }
  .totals td:last-child { text-align: right; white-space: nowrap; font-weight: 600; }
  .totals td:first-child { color: var(--slate); }
  .totals .grand td { color: var(--navy-dark); font-size: 14px; font-weight: 800; padding: 9px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .totals .grand td:first-child { letter-spacing: .4px; }
  .totals .grand td:last-child { font-weight: 800; }

  /* ── Sections ── */
  .section { margin-top: 15px; }
  .section-title { color: var(--navy-dark); font-size: 10px; font-weight: 700; border-bottom: 1px solid var(--line); padding-bottom: 4px; margin-bottom: 8px; }

  /* ── Tax table ── */
  .tax-table { width: 100%; border-collapse: collapse; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .tax-table th { background: var(--navy-soft); color: var(--navy-dark); padding: 6px 8px; font-size: 8.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; text-align: right; border-bottom: 1px solid var(--line); }
  .tax-table th:first-child, .tax-table td:first-child { text-align: left; }
  .tax-table td { padding: 6px 8px; border-bottom: 1px solid var(--line); font-size: 9.5px; text-align: right; }
  .tax-table tbody tr:last-child td { border-bottom: none; }
  .tax-rate-chip { display: inline-block; background: var(--navy-soft); color: var(--navy-dark); border-radius: 999px; padding: 1px 8px; font-size: 8.5px; font-weight: 700; }

  /* ── Installment panel ── */
  .installment-agreement-page,
  .installment-details-page { break-before: page; page-break-before: always; }
  .installment-agreement-page { break-after: page; page-break-after: always; }
  .installment-agreement-page .section { margin-top: 0; }
  .inst-panel { background: #f8fafc; border: 1px solid var(--line); border-top: 3px solid var(--navy); border-radius: 6px; padding: 12px; margin-top: 2px; }
  .inst-product-card { background: var(--white); border: 1px solid var(--line); border-radius: 5px; padding: 8px 10px; margin-bottom: 10px; }
  .inst-product-name { font-weight: 700; font-size: 11px; color: var(--navy-dark); }
  .inst-product-meta { color: var(--slate); font-size: 8.5px; margin-top: 2px; }
  .inst-summary { width: 100%; border-collapse: collapse; margin: 6px 0 10px; background: #fff; border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
  .inst-summary td { padding: 5px 9px; border-bottom: 1px solid var(--line); font-size: 9.5px; vertical-align: top; }
  .inst-summary tr:last-child td { border-bottom: none; }
  .inst-summary td:first-child { width: 50%; background: #f8fafc; color: var(--slate); }
  .inst-summary td:last-child { font-weight: 600; }
  .inst-summary tr.highlight td:last-child { font-weight: 800; color: var(--navy-dark); }
  .inst-summary tr.highlight-green td:last-child { color: var(--green); font-weight: 800; }
  .inst-summary tr.highlight-amber td:last-child { color: #b45309; font-weight: 800; }
  .inst-summary tr.highlight-red td:last-child { color: var(--red); font-weight: 800; }

  /* Status badges */
  .badge { display: inline-block; padding: 1.5px 8px; border-radius: 999px; font-size: 8px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; }
  .badge-active { background: #dbeafe; color: #1d4ed8; }
  .badge-completed { background: var(--green-light); color: #15803d; }
  .badge-overdue { background: var(--red-light); color: #b91c1c; }
  .badge-pending { background: #f1f5f9; color: #475569; }
  .badge-partial { background: var(--amber-light); color: #92400e; }
  .badge-paid { background: var(--green-light); color: #15803d; }
  .badge-cancelled { background: #f1f5f9; color: #64748b; }

  /* Schedule table */
  .sched-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
  .sched-table th { background: var(--navy-soft); color: var(--navy-dark); padding: 5px 6px; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; border-bottom: 1px solid var(--line); }
  .sched-table th:not(:first-child), .sched-table td:not(:first-child) { text-align: right; }
  .sched-table td { padding: 5px 6px; border-bottom: 1px solid var(--line); font-size: 9px; }
  .sched-table tbody tr:nth-child(even) td { background: #f8fafc; }
  .sched-table tbody tr:last-child td { border-bottom: none; }

  /* Payment history */
  .pay-hist { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
  .pay-hist th { background: var(--navy-soft); color: var(--navy-dark); padding: 5px 7px; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; border-bottom: 1px solid var(--line); }
  .pay-hist td { padding: 5px 7px; border-bottom: 1px solid var(--line); font-size: 9px; vertical-align: top; }
  .pay-hist td:last-child { text-align: right; font-weight: 700; }
  .pay-hist tbody tr:nth-child(even) td { background: #f8fafc; }
  .pay-hist tbody tr:last-child td { border-bottom: none; }

  /* Signature lines */
  .sig-section { margin-top: 18px; border-top: 1px dashed var(--line); padding-top: 12px; }
  .sig-grid { display: table; width: 100%; border-collapse: collapse; }
  .sig-col { display: table-cell; width: 33.33%; vertical-align: top; padding-right: 12px; }
  .sig-col:last-child { padding-right: 0; }
  .sig-label { font-size: 8px; color: var(--slate); font-weight: 700; text-transform: uppercase; letter-spacing: .7px; margin-bottom: 24px; }
  .sig-line { border-bottom: 1px solid var(--ink); height: 1px; margin-bottom: 3px; }
  .sig-name { font-size: 8px; color: var(--slate); }
  .sig-date-row { display: table; width: 100%; margin-top: 4px; }
  .sig-date-label { font-size: 8px; color: var(--slate); }
  .sig-date-line { display: inline-block; border-bottom: 1px solid var(--slate); width: 70px; }

  /* Balance note */
  .balance-note { border-left: 3px solid var(--navy); margin-top: 10px; font-size: 8.5px; color: var(--slate); background: var(--navy-soft); padding: 6px 9px; border-radius: 3px; }

  /* ── Footer ── */
  .footer-section { margin-top: 15px; border-top: 2px solid var(--line); padding-top: 9px; display: table; width: 100%; border-collapse: collapse; }
  .footer-left { display: table-cell; vertical-align: bottom; }
  .footer-right { display: table-cell; vertical-align: bottom; text-align: right; }
  .qr { width: 76px; height: 76px; }
  .footer-text { font-size: 8.5px; color: var(--slate); line-height: 1.6; }
  .stamp { color: var(--navy-dark); background: var(--navy-soft); border: 1px dashed var(--navy); border-radius: 4px; display: inline-block; padding: 5px 10px; margin: 8px 0; font-size: 9.5px; font-weight: 600; overflow-wrap: anywhere; }
  .thanks { text-align: center; margin-top: 12px; color: var(--slate); font-size: 9px; }
  .powered { display: inline-block; margin-top: 3px; font-size: 7.5px; letter-spacing: 1px; text-transform: uppercase; color: #94a3b8; }

  /* ── COMPACT / RECEIPT PAPER ── */
  {{#if paper.compact}}
  body { font-size: 9px; line-height: 1.4; }
  .header { padding-bottom: 6px; margin-bottom: 6px; }
  .header-left, .header-right { display: block; width: 100%; padding: 0; text-align: left; }
  .header-right { padding-top: 5px; }
  .brand-logo { max-width: 80px; max-height: 30px; }
  .biz-name { font-size: 12px; }
  .invoice-title { font-size: 12px; }
  .invoice-urdu { font-size: 9px; }
  .payment-badge { font-size: 7px; padding: 1px 8px; }
  .meta-table td { font-size: 8px; }
  .meta-table tr:first-child td:last-child { font-size: 9px; }
  .customer-card { margin-top: 6px; padding: 5px 7px; }
  .customer-col { display: block; width: 100%; padding: 0 0 5px; border: none; }
  .customer-col + .customer-col { padding: 5px 0 0; border-top: 1px solid var(--line); border-left: none; }
  .card-name { font-size: 9.5px; }
  .card-detail { font-size: 8px; }
  .items { table-layout: fixed; }
  .items th, .items td { padding: 4px 3px; font-size: 8px; }
  .items .col-idx, .items .col-price, .items .col-disc, .items .col-tax { display: none; }
  .items .col-desc { width: 46%; }
  .items .col-qty { width: 17%; overflow-wrap: anywhere; }
  .items .col-amt { width: 37%; white-space: normal; overflow-wrap: anywhere; }
  .items .compact-detail { display: block; }
  .totals-wrap { width: 100%; margin-top: 6px; }
  .totals td { padding: 2px 5px; font-size: 8px; }
  .totals .grand td { font-size: 11px; padding: 5px; }
  .section { margin-top: 8px; }
  .section-title { font-size: 7.5px; }
  .tax-table th, .tax-table td { padding: 3px 3px; font-size: 7.5px; }
  .tax-rate-chip { font-size: 7px; padding: 0 6px; }
  .inst-panel { padding: 5px; }
  .inst-summary td { padding: 3px; font-size: 8px; }
  .sched-table, .pay-hist { table-layout: fixed; }
  .sched-table th, .sched-table td, .pay-hist th, .pay-hist td { padding: 2px 3px; font-size: 7px; overflow-wrap: anywhere; }
  .sig-section { margin-top: 10px; padding-top: 8px; }
  .sig-label { margin-bottom: 16px; }
  .sig-grid { table-layout: fixed; }
  .sig-col { box-sizing: border-box; padding-right: 4px; overflow-wrap: anywhere; }
  .footer-section { margin-top: 8px; padding-top: 5px; }
  .qr { width: 48px; height: 48px; }
  .footer-text { font-size: 7.5px; }
  .thanks { margin-top: 7px; font-size: 7.5px; }
  .powered { font-size: 6.5px; }
  .logo-watermark { width: 70%; height: auto; }
  .header .meta-table td:last-child { overflow-wrap: anywhere; }
  {{/if}}
</style>
</head>
<body>

{{#if showLogoWatermark}}
<div class="logo-watermark"><img src="{{tenant.logoUrl}}" alt="" /></div>
{{/if}}

<div class="page">
{{#if tenant.watermark}}<div class="text-watermark">{{tenant.watermark}}</div>{{/if}}

<!-- ═══════════════ HEADER ═══════════════ -->
<div class="header">
  <div class="header-left">
    {{#if tenant.logoUrl}}<img class="brand-logo" src="{{tenant.logoUrl}}" alt="Logo" />{{/if}}
    <div class="biz-name"><bdi>{{tenant.name}}</bdi></div>
    {{#if tenant.address}}<div class="biz-detail"><bdi>{{tenant.address}}</bdi></div>{{/if}}
    {{#if tenant.taxRegNo}}<div class="biz-ntn"><strong>NTN/STRN:</strong> {{tenant.taxRegNo}}</div>{{/if}}
  </div>
  <div class="header-right">
    <div class="invoice-title">{{title}}</div>
    <div class="invoice-urdu" lang="ur">رسید / انوائس</div>
    <div><span class="payment-badge mode-{{paymentMode}}">{{upper paymentMode}}</span></div>
    <table class="meta-table">
      <tr><td>Invoice no.</td><td>{{invoiceNo}}</td></tr>
      <tr><td>Date</td><td>{{issuedAt}}</td></tr>
      <tr><td>Cashier</td><td><bdi>{{cashierName}}</bdi></td></tr>
      {{#each payments}}<tr><td>{{upper mode}}</td><td>{{money amount}}</td></tr>{{/each}}
    </table>
  </div>
</div>

<!-- ═══════════════ CUSTOMER CARD ═══════════════ -->
{{#if installment}}
  {{#if installment.customer}}
  <div class="customer-card">
    <div class="customer-card-row">
      <div class="customer-col">
        <div class="card-eyebrow">Buyer / <span class="urdu" lang="ur" style="font-size:9px">خریدار</span></div>
        <div class="card-name"><bdi>{{installment.customer.name}}</bdi></div>
        {{#if installment.customer.phone}}<div class="card-detail">Phone {{installment.customer.phone}}</div>{{/if}}
        {{#if installment.customer.cnic}}<div class="card-detail">ID: {{installment.customer.cnic}}</div>{{/if}}
        {{#if installment.customer.address}}<div class="card-detail"><bdi>{{installment.customer.address}}</bdi></div>{{/if}}
      </div>
      {{#if installment.guarantor}}
      <div class="customer-col">
        <div class="card-eyebrow">Guarantor / <span class="urdu" lang="ur" style="font-size:9px">ضامن</span></div>
        <div class="card-name"><bdi>{{installment.guarantor.name}}</bdi></div>
        {{#if installment.guarantor.phone}}<div class="card-detail">Phone {{installment.guarantor.phone}}</div>{{/if}}
        {{#if installment.guarantor.cnic}}<div class="card-detail">ID: {{installment.guarantor.cnic}}</div>{{/if}}
        {{#if installment.guarantor.address}}<div class="card-detail"><bdi>{{installment.guarantor.address}}</bdi></div>{{/if}}
      </div>
      {{/if}}
    </div>
  </div>
  {{/if}}
{{else if customer}}
<div class="customer-card">
  <div class="customer-card-row">
    <div class="customer-col">
      <div class="card-eyebrow">Billed to</div>
      {{#if customer.name}}<div class="card-name"><bdi>{{customer.name}}</bdi></div>{{/if}}
      {{#if customer.phone}}<div class="card-detail">Phone {{customer.phone}}</div>{{/if}}
      {{#if customer.cnic}}<div class="card-detail">ID: {{customer.cnic}}</div>{{/if}}
      {{#if customer.address}}<div class="card-detail"><bdi>{{customer.address}}</bdi></div>{{/if}}
    </div>
    {{#if customer.guarantor}}
    <div class="customer-col">
      <div class="card-eyebrow">Guarantor</div>
      <div class="card-name"><bdi>{{customer.guarantor.name}}</bdi></div>
      {{#if customer.guarantor.phone}}<div class="card-detail">Phone {{customer.guarantor.phone}}</div>{{/if}}
      {{#if customer.guarantor.cnic}}<div class="card-detail">ID: {{customer.guarantor.cnic}}</div>{{/if}}
      {{#if customer.guarantor.address}}<div class="card-detail"><bdi>{{customer.guarantor.address}}</bdi></div>{{/if}}
    </div>
    {{/if}}
  </div>
</div>
{{/if}}

<hr class="rule" />

<!-- ═══════════════ ITEMS TABLE ═══════════════ -->
<table class="items">
  <thead>
    <tr>
      <th class="col-idx" style="width:4%">#</th>
      <th class="col-desc">Description</th>
      <th class="right col-qty">Qty</th>
      <th class="right col-price">Unit Price</th>
      <th class="right col-disc">Disc.</th>
      {{#if totals.taxTotal}}<th class="right col-tax">Tax%</th>{{/if}}
      <th class="right col-amt">Amount ({{tenant.currency}})</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <td class="col-idx">{{inc @index}}</td>
      <td class="col-desc">
        <bdi>{{name}}</bdi>
        {{#if ../paper.compact}}<span class="product-sub compact-detail">Unit {{money unitPrice}}{{#if discountAmount}} · Disc. {{money discountAmount}}{{/if}}{{#if ../totals.taxTotal}} · Tax {{pct taxPercent}}{{/if}}</span>{{/if}}
        {{#if productId}}<span class="product-sub">ID: <bdi dir="ltr">{{productId}}</bdi></span>{{/if}}
        {{#if serialNo}}<span class="product-sub">S/N: <bdi dir="ltr">{{serialNo}}</bdi></span>{{/if}}
      </td>
      <td class="right col-qty num">{{qty qty}}</td>
      <td class="right col-price num">{{money unitPrice}}</td>
      <td class="right col-disc num">{{#if discountAmount}}{{money discountAmount}}{{else}}—{{/if}}</td>
      {{#if ../totals.taxTotal}}<td class="right col-tax num">{{pct taxPercent}}</td>{{/if}}
      <td class="right col-amt">{{money lineTotal}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<!-- ═══════════════ TOTALS ═══════════════ -->
<div class="totals-wrap">
  <table class="totals">
    <tr><td>Subtotal</td><td>{{money totals.subtotal}}</td></tr>
    {{#if totals.discountTotal}}<tr><td>Discount</td><td>− {{money totals.discountTotal}}</td></tr>{{/if}}
    {{#if totals.taxTotal}}<tr><td>Taxable amount</td><td>{{money totals.taxableTotal}}</td></tr>
    <tr><td>Total tax</td><td>{{money totals.taxTotal}}</td></tr>{{/if}}
    {{#each totals.charges}}<tr><td>{{label}}</td><td>{{money amount}}</td></tr>{{/each}}
    <tr class="grand"><td>TOTAL ({{tenant.currency}})</td><td>{{money totals.grandTotal}}</td></tr>
  </table>
</div>

<!-- ═══════════════ TAX BREAKDOWN ═══════════════ -->
{{#if totals.taxTotal}}
<div class="section">
  <div class="section-title">Tax Breakdown</div>
  <table class="tax-table">
    <thead><tr><th>Rate</th><th>Taxable Amount</th><th>Tax Amount</th></tr></thead>
    <tbody>
      {{#each totals.taxBreakdown}}
      <tr><td><span class="tax-rate-chip">{{pct ratePercent}}</span></td><td>{{money taxableAmount}}</td><td>{{money taxAmount}}</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{/if}}

<!-- ═══════════════ INSTALLMENT AGREEMENT ═══════════════ -->
{{#if installment}}
<section class="installment-agreement-page">
  <div class="section">
    <div class="section-title">
      Installment Agreement
      {{#if installment.agreementId}}— {{installment.agreementId}}{{/if}}
    </div>
    <div class="inst-panel">

    <!-- Product snapshot -->
    {{#ifAny items}}
    <div class="inst-product-card">
      <div class="card-eyebrow" style="margin-bottom:4px">Products / Items</div>
      {{#each items}}
      <div style="{{#unless @first}}margin-top:6px; padding-top:6px; border-top:1px solid var(--line);{{/unless}}">
        <div class="inst-product-name"><bdi>{{name}}</bdi></div>
        <div class="inst-product-meta">
          Qty: {{qty qty}} &nbsp;·&nbsp; Unit: {{money unitPrice}} &nbsp;·&nbsp; Total: {{money lineTotal}}
          {{#if serialNo}}&nbsp;·&nbsp; S/N: <bdi>{{serialNo}}</bdi>{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/ifAny}}

    <!-- Plan summary table -->
    <table class="inst-summary">
      {{#if installment.status}}
      <tr><td>Agreement status</td><td><span class="badge badge-{{installment.status}}">{{installment.status}}</span></td></tr>
      {{/if}}
      <tr><td>Cash price</td><td>{{money installment.cashPrice}}</td></tr>
      <tr class="highlight-green"><td>Down payment received</td><td>{{money installment.downPayment}}</td></tr>
      <tr><td>Financed principal</td><td>{{money installment.principal}}</td></tr>
      <tr><td>Finance charges</td><td>{{money installment.charges}}</td></tr>
      {{#if installment.markupPercent}}<tr><td>Markup rate</td><td>{{pct installment.markupPercent}}</td></tr>{{/if}}
      <tr class="highlight"><td>Total payable</td><td>{{money installment.totalPayable}}</td></tr>
      <tr><td>Paid to date</td><td>{{money installment.paidToDate}}</td></tr>
      <tr class="highlight-amber"><td>Remaining balance</td><td>{{money installment.remaining}}</td></tr>
      {{#if installment.overdue}}<tr class="highlight-red"><td>Overdue amount</td><td>{{money installment.overdue}}</td></tr>{{/if}}
      <tr><td>Payment plan</td><td>{{installment.frequency}} / {{installment.count}} installments</td></tr>
      {{#if installment.firstDueDate}}<tr><td>First payment due</td><td>{{installment.firstDueDate}}</td></tr>{{/if}}
      {{#if installment.monthlyAmount}}<tr><td>Regular installment</td><td>{{money installment.monthlyAmount}}</td></tr>{{/if}}
      {{#if installment.nextDue}}<tr class="highlight"><td>Next payment due</td><td>{{installment.nextDue.dueDate}} &nbsp;·&nbsp; {{money installment.nextDue.amount}}</td></tr>{{/if}}
    </table>

    </div>
  </div>
</section>

<!-- ═══════════════ INSTALLMENT DETAILS — NEXT PAGE ═══════════════ -->
<section class="installment-details-page">
  <div class="section">
    <div class="inst-panel">

    <!-- Payment schedule -->
    <div class="section-title" style="margin-top:0; margin-bottom:6px">Payment Schedule / <span class="urdu" lang="ur" style="font-size:9px">اقساط کا شیڈول</span></div>
    <table class="sched-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Due Date</th>
          <th>Due</th>
          <th>Paid</th>
          <th>Remaining</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {{#each installment.schedule}}
        <tr>
          <td>{{no}}</td>
          <td>{{dueDate}}</td>
          <td>{{money amount}}</td>
          <td>{{money paidAmount}}</td>
          <td>{{money remainingAmount}}</td>
          <td><span class="badge badge-{{status}}">{{status}}</span></td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Payment history -->
    {{#if installment.payments.length}}
    <div class="section-title" style="margin-top:10px; margin-bottom:6px">Payment History / <span class="urdu" lang="ur" style="font-size:9px">ادائیگی کی تفصیلات</span></div>
    <table class="pay-hist">
      <thead>
        <tr>
          <th>Receipt / Date</th>
          <th>Method</th>
          <th>Received by</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each installment.payments}}
        <tr>
          <td><bdi>{{receiptNo}}</bdi><br/>{{paidAt}}{{#if note}}<br/><em><bdi>{{note}}</bdi></em>{{/if}}</td>
          <td>{{upper mode}}</td>
          <td><bdi>{{receivedBy}}</bdi></td>
          <td>{{money amount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    <div class="balance-note">Balance snapshot at the time this receipt was printed. Refer to the account ledger for later transactions.</div>

    <!-- Signature section -->
    <div class="sig-section">
      <div class="section-title" style="margin-bottom:10px">Signatures / <span class="urdu" lang="ur" style="font-size:9px">دستخط</span></div>
      <div class="sig-grid">
        <div class="sig-col">
          <div class="sig-label">Customer</div>
          <div class="sig-line"></div>
          <div class="sig-name">{{#if installment.customer}}{{installment.customer.name}}{{else}}_______________{{/if}}</div>
          <div style="margin-top:5px"><span class="sig-date-label">Date: </span><span class="sig-date-line"></span></div>
        </div>
        <div class="sig-col">
          <div class="sig-label">Guarantor</div>
          <div class="sig-line"></div>
          <div class="sig-name">{{#if installment.guarantor}}{{installment.guarantor.name}}{{else}}_______________{{/if}}</div>
          <div style="margin-top:5px"><span class="sig-date-label">Date: </span><span class="sig-date-line"></span></div>
        </div>
        <div class="sig-col">
          <div class="sig-label">Authorized by</div>
          <div class="sig-line"></div>
          <div class="sig-name">_______________</div>
          <div style="margin-top:5px"><span class="sig-date-label">Stamp: </span></div>
        </div>
      </div>
    </div>
  </div>
</section>
{{/if}}

<!-- ═══════════════ FOOTER ═══════════════ -->
<div class="footer-section">
  <div class="footer-left">
    {{#if tenant.stamp}}<div class="stamp">{{tenant.stamp}}</div>{{/if}}
    <div class="footer-text">Scan QR to verify this invoice.<br/>This is a computer-generated document.</div>
  </div>
  <div class="footer-right">
    <img class="qr" src="{{qrDataUrl}}" alt="Invoice QR" />
  </div>
</div>

<div class="thanks">
  {{#if tenant.footerText}}<bdi>{{tenant.footerText}}</bdi>{{else}}Thank you for your business!{{/if}}<br/>
  <span class="powered">Powered by KazmiOn POS</span>
</div>

</div><!-- .page -->
</body>
</html>
