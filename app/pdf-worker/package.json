{
  "name": "@pos/pdf-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"if (process.env.PUPPETEER_SKIP_DOWNLOAD !== 'true') require('node:child_process').execSync('npx puppeteer browsers install chrome', {stdio:'inherit'})\"",
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "worker:dev": "wrangler dev src/worker-entry.ts --compatibility-flags=nodejs_compat",
    "worker:deploy": "npm run build && wrangler deploy",
    "render:sample": "tsx src/render-sample.ts",
    "test": "tsx --test src/services/invoice-renderer.test.ts src/services/paper.test.ts"
  },
  "dependencies": {
    "@pos/invoice-store": "file:../packages/invoice-store",
    "bullmq": "^6.3.12",
    "dotenv": "^18.0.7",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "puppeteer": "^25.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "4.168.0"
  }
}
